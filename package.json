{
  "name": "stukje-notes",
  "version": "1.0.0",
  "description": "A simple, elegant monochrome note-taking app",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.stukje.notes",
    "productName": "Stukje Notes",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "stukjeIcon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "src/**/*",
      "package.json",
      "stukjeIcon.png"
    ]
  },
  "keywords": [
    "notes",
    "electron",
    "minimal"
  ],
  "author": "Stukje",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1"
  }
}
